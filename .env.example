# Server-side environment only. Keep the key out of web/.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Optional; default: gpt://<YANDEX_FOLDER_ID>/aliceai-llm
YANDEX_MODEL_URI=
# Optional common source:
# INCIDENTS_SOURCE_URL=https://your-source.example/incidents.json
# Optional actual ITSM incident link. {id} and {sysId} are encoded as strings.
# ITSM_INCIDENT_URL_TEMPLATE=https://your-itsm.example/incidents/{sysId}
# Verified sign-in emails allowed to replace/export the shared dataset (server only):
DATA_EDITOR_EMAILS=
# Local preview ONLY. Uses a fictional editor; never affects the hosted Worker.
# DEV_EDITOR_PREVIEW=1
# Local defaults: HOST=127.0.0.1, PORT=4173
# For LAN preview only, explicitly set HOST=0.0.0.0 (guest mode recommended).
# INCIDENTS_FILE=/absolute/path/to/incidents.json
# LOCAL_DB_PATH=/absolute/path/to/incidents.sqlite

# Optional: set 0 to close self-registration; login still works.
# AUTH_REGISTRATION_OPEN=0

# Local encrypted AI-settings form: run npm run ai:prepare (never commit .env).
# AI_CONFIG_ENCRYPTION_KEY=
